# Obulus cockpit environment — copy to .env.local and fill in.
# All values are PUBLIC (they end up in the browser bundle). Never put a private key here.

# Hub base URL (the coordination API). Prod: https://api.<your-domain>
VITE_API_URL=http://localhost:8787

# Target chain — OPTIONAL, the code defaults to 46630 (Robinhood Chain testnet).
# Other values: 4663 = Robinhood Chain mainnet, 31337 = local anvil.
VITE_CHAIN_ID=46630

# Deployed contract addresses (from contracts/deployments/<chainId>.json — scripts/testnet-env.mts fills
# these). For an env-free Cloudflare build you can instead bake them into the BAKED_ADDRESSES map in
# src/lib/config.ts (testnet only).
VITE_ESCROW_ADDRESS=
VITE_USDG_ADDRESS=
# (the legacy VITE_USDC_ADDRESS is still read as a fallback, so an existing Cloudflare config keeps working)

# ── Migrating this cockpit to Robinhood Chain MAINNET ────────────────────────
# Nothing to code — these three build vars are the whole switch. They only work once the Escrow is
# actually deployed on 4663: BAKED_ADDRESSES has no mainnet entry, so without VITE_ESCROW_ADDRESS the
# app renders the configuration-error screen instead of booting.
#
#   VITE_CHAIN_ID=4663
#   VITE_ESCROW_ADDRESS=<from contracts/deployments/4663.json, after DeployRobinhoodMainnet>
#   VITE_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168   # USDG (Global Dollar), 6 decimals
#
# ⛔ USDG is the settlement asset on mainnet — Robinhood Chain has NO canonical USDC, and the mainnet
# explorer lists several impostor "USDC" tokens. Never substitute one. The displayed ticker follows
# the chain automatically (ASSET_SYMBOL in src/lib/format.ts): USDG on 4663, USDC elsewhere.
#
# Full go-live order (contracts first, then Hub, then this app): see MAINNET.md.
# ─────────────────────────────────────────────────────────────────────────────

# Optional dedicated RPC endpoint. Testnet default is baked in: https://rpc.testnet.chain.robinhood.com.
# KEYED endpoint (QuickNode/Alchemy)? Don't put it here (public bundle!) — use the functions/rpc.js
# proxy: set the encrypted RPC_UPSTREAM var on Cloudflare and point this at https://app.<domain>/rpc.
VITE_RPC_URL=

# Optional: enables the WalletConnect connector when set (cloud.walletconnect.com project id).
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: prefills the arbiter field of the create-offer form.
VITE_DEFAULT_ARBITER=
